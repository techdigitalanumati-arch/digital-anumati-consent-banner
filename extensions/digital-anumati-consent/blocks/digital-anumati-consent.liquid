{% comment %}
  AbyM Consent Banner for Digital Anumati
  Shopify App Embed Block for India DPDP Act 2023 & DPDP Rules 2025 compliance.
{% endcomment %}

<!-- AbyM Digital Anumati Blocker Script (Head) -->
<script
  id="abymdac-blocker"
  src="https://consent.digitalanumati.com/anumati-blocker.js"
  {% if block.settings.site_key != blank %}data-site-key="{{ block.settings.site_key | escape }}"{% endif %}
  async>
</script>

<!-- AbyM Digital Anumati Consent Banner Script (Appended at top of <body>) -->
<script>
  (function () {
    'use strict';
    var scriptId = 'abymdac-consent';
    var scriptSrc = 'https://consent.digitalanumati.com/anumati-dpdp-consent-v1.js';

    function addBodyScript() {
      if (!document.body || document.getElementById(scriptId)) return;
      var script = document.createElement('script');
      script.id = scriptId;
      script.src = scriptSrc;
      document.body.insertBefore(script, document.body.firstChild);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', addBodyScript, { once: true });
    } else {
      addBodyScript();
    }
  })();
</script>

{% if block.settings.site_key == blank %}
  <!-- Digital Anumati Warning: Site Key is blank. Please enter your Site Key in Theme Editor -> App Embeds -> Digital Anumati Consent -->
{% endif %}



{% schema %}
{
  "name": "Digital Anumati Consent",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "site_key",
      "label": "Digital Anumati Site Key",
      "info": "Enter your unique Site Key provided by Digital Anumati. Required to activate the banner.",
      "placeholder": "e.g. APP_khanna-hospital_1783346400770"
    }
  ]
}
{% endschema %}


